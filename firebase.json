{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "predeploy": ["npm run build", "node scripts/copy-index-template.mjs"],
    "rewrites": [
      { "source": "/room/*/og-image.png", "function": "ogImage" },
      { "source": "/room/**", "function": "renderRoom" },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs20"
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  }
}
