rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Casual, friends-only game lobbies (create/join/leave, settings,
    // roster). Any signed-in (anonymous) user can read/join a room if they
    // know its invite code. The live game itself runs on PartyKit
    // (party/uno.js) — this doc only ever sees a mirrored `status` from the
    // host (see room.js#connectSession) so a late joinRoom() can still tell
    // a finished game apart from a live one.
    match /rooms/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.hostUid == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
                    && resource.data.hostUid == request.auth.uid;
    }
  }
}
