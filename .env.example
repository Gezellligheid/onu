VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Discord Developer Portal → your app → General Information → Application ID
VITE_DISCORD_CLIENT_ID=

# PartyKit host after `npm run party:deploy`, e.g. onu-uno.<your-username>.partykit.dev
# (no protocol prefix). Leave unset locally to use the `party:dev` server on localhost:1999.
VITE_PARTYKIT_HOST=
